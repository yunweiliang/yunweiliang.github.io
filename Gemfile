source "https://rubygems.org"

# Only used to preview the site locally (`bundle exec jekyll serve`);
# GitHub Pages ignores this file and builds with its own Jekyll 3.10.
# These versions match what GitHub Pages uses. The full "github-pages" gem
# is not used because it pins an old rubyzip with a known vulnerability,
# and this site needs none of its extra plugins.
gem "jekyll", "3.10.0"
gem "kramdown", "2.4.0"
gem "kramdown-parser-gfm", "1.1.0"

# Needed on Ruby 3+ for `jekyll serve`, and to silence stdlib warnings.
gem "webrick", "~> 1.8"
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
